    evaluated_dcs_out_path: ${data.paths.constraints_dir_path}/phishing-10cols__DC_threshold=0.01__fastadc_dcs__eval.csv
ml_model:
  model_type: mlp
  model_artifact_path: trained-models/${data.name}-${ml_model.model_type}.ckpt
  perform_training: ${perform_training}
  perform_grid_search_hparams: ${perform_training_grid_search_hparams}
  default_hparams:
    n_layers: 3
    hidden_dim: 128
    lr: 0.001
    weight_decay: 1.0e-05
attack:
  attack_name: cafa
  random_init: true
  random_seed: null
  max_iter: 250
  max_iter_tabpgd: 100
  eps: 0.03333333333333333
  step_size: 0.0003333333333333333
  perturb_categorical_each_steps: 10
constraints:
